{
  "name": "panda-themes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "panda codegen --spec=public/design-system.json",
    "dev": "panda codegen --spec=public/design-system.json && next dev",
    "build": "panda codegen --spec=public/design-system.json && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:contrast": "node --no-warnings scripts/check-contrast.mjs"
  },
  "dependencies": {
    "@ark-ui/react": "^5.39.3",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@pandacss/dev": "^2.2.0",
    "@pandacss/preset-base": "2.2.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.13.1"
}
